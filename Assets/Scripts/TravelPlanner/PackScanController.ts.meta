  InputLines:
    - '// @input AssignableType geminiAssistant {"hint":"Trip context source (destination, dates, purpose)."}'
    - '// @input AssignableType_1 scanButton {"hint":"Pinch button that opens the Pack scan session."}'
    - '// @input AssignableType_2 captureButton {"hint":"Pinch button shown while a session is open. Snapshots the current view to Gemini Vision."}'
    - '// @input AssignableType_3 cropScanButton {"hint":"Pinch button that toggles Crop mode (hides the live preview, shows the crop hint)."}'
    - '// @input AssignableType_4 closeButton {"hint":"Pinch button that closes the scan session, releases the preview, and clears the HUD inline text."}'
    - '// @input SceneObject packScanHud {"hint":"Pack HUD root. Scan is gated to only run when this HUD is enabled."}'
    - '// @input Component.Text packHudText {"hint":"Main inline text inside Pack HUD. Cleared by Close; latest result is mirrored to detailBodyText."}'
    - '// @input Component.Text detailBodyText {"hint":"Persistent Pack detail text. Preserved across Close and the next time the category row is tapped."}'
    - '// @input Component.Text observedItemsText {"hint":"Optional Text of items the user typed (kept for text-only fallback). Do NOT point at keyboard entry text."}'
    - '// @input SceneObject cameraPreviewRoot {"hint":"SceneObject of the CropCameraTexture package preview (e.g. `CropCameraTextureTS`). Toggled visible while a session is open."}'
    - '// @input Asset.Texture originalCameraTexture {"hint":"Original camera Texture from the package (Device Camera Texture). Used for full-frame capture."}'
    - '// @input Asset.Texture cropCameraTexture {"hint":"Cropped camera Texture from the package (Screen Crop Texture). Used for cropped capture."}'
    - '// @input SceneObject cropHintRoot {"hint":"Optional UI root for the Crop hint (text / dotted overlay). Shown only in Crop mode."}'
    - '// @input string geminiModel = "gemini-2.0-flash" {"hint":"Gemini model for pack-check generation. gemini-2.0-flash supports inlineData images."}'
    - '// @input float captureIntervalMs = 250 {"hint":"Capture interval (ms) hint for the VideoController used during a one-shot snapshot."}'
    - '// @input bool verboseLogs = true {"hint":"Enable PackScanController logs."}'
